# Bearer token protecting /mcp — pick something long and random,
# e.g. `openssl rand -hex 32`.
MCP_ZEROMEM_TOKEN=change-me

# Trusted local network escape hatch: set to true to run without a token
# (the HTTP server refuses to start with neither). Leave unset unless the
# server is unreachable from untrusted networks.
# SECURE_LOCAL_NET=true

# Hide the write tools (remember / ingest / forget) from MCP clients.
# ZEROMEM_READ_ONLY=true

# How many characters of a turn `zeromem_recall` with `format: text` prints
# before clipping it. A clip is always marked with the zeromem_read_session
# call that returns the rest, so a model never mistakes a fragment for the
# whole memory. Raise it for hosts that paste recall straight into a prompt.
# `format: json` is never clipped. Per call: `max_chars` (100–20000).
# ZEROMEM_RECALL_TEXT_LIMIT=2000

# Where the store lives. Inside the container this is /data; on the host it
# defaults to ./data. ZEROMEM_HOME, if set, must be the same directory.
# DATA_DIR=./data

# Which embedder a NEW store is built with. `auto` (the default) loads the
# ONNX model (bge-small-en-v1.5, downloaded on first use into $ZEROMEM_MODELS,
# i.e. /data/models in the container) and falls back to a hashed bag-of-words
# embedder, loudly, if it cannot; `onnx` refuses to start instead; `hash`
# never downloads anything; `openai` uses the endpoint below; `none` gives
# this process no dense view. An existing store keeps the embedder it was
# built with — change it from the Settings page or with `zm embedder set`.
# ZEROMEM_EMBEDDER=auto

# Force an existing store onto ZEROMEM_EMBEDDER at boot: every vector is
# dropped and re-embedded in the background. Normally unnecessary; the
# Settings page does the same without a restart.
# ZEROMEM_ALLOW_EMBEDDER_SWITCH=true

# An OpenAI-compatible embeddings endpoint (POST {URL}/embeddings): Ollama,
# llama.cpp, vLLM, LM Studio, an NPU box, or the hosted API. URL and MODEL are
# required with ZEROMEM_EMBEDDER=openai; the vector size is learned from the
# first response. The key overrides one saved from the Settings page and is
# never returned by the API. The prefixes are for models that want them
# (`query: ` / `passage: ` for E5).
# ZEROMEM_EMBEDDING_URL=http://npu-box:11434/v1
# ZEROMEM_EMBEDDING_MODEL=nomic-embed-text
# ZEROMEM_EMBEDDING_API_KEY=
# ZEROMEM_EMBEDDING_QUERY_PREFIX=
# ZEROMEM_EMBEDDING_DOCUMENT_PREFIX=
# ZEROMEM_EMBEDDING_TIMEOUT_MS=5000

# Where the model files live. Defaults to <DATA_DIR>/models.
# ZEROMEM_MODELS=./data/models

# Session id of the agent this server serves. zeromem_recall leaves it out by
# default so recall does not echo the current conversation back.
# ZEROMEM_SESSION_ID=

# The scope (e.g. project:atlas) this server and `zm` read and write when a call
# names none. Unset: writes are unscoped and recall searches every scope.
# ZEROMEM_SCOPE=

# A bearer token for /mcp that adds the curator tools and prompts (at least
# 16 characters). Overrides one set from the Settings page.
# MCP_ZEROMEM_CURATOR_TOKEN=

# A local model as the curator (`npm run curate`, or `mcp-zeromem-curate`):
# any OpenAI-compatible chat endpoint that supports tool calls (Lemonade,
# llama.cpp, Ollama, vLLM). The server never reads these; it runs no agent.
# URL is the base up to the version, so requests go to {URL}/chat/completions.
# ZEROMEM_CURATOR_LLM_URL=http://framework.lan:13305/api/v1
# ZEROMEM_CURATOR_LLM_MODEL=qwen3.6-moe-35b-a3b-FLM
# ZEROMEM_CURATOR_LLM_API_KEY=
# Per request. A local model reads the playbook slowly; the default is ten minutes.
# ZEROMEM_CURATOR_LLM_TIMEOUT_MS=600000
# Model requests one run may make before it is stopped and reported unfinished.
# ZEROMEM_CURATOR_MAX_STEPS=40
# Curate a running server over /mcp (needs MCP_ZEROMEM_CURATOR_TOKEN) instead
# of opening the store under DATA_DIR in the curator's own process.
# ZEROMEM_CURATOR_MCP_URL=http://localhost:3200/mcp

# The model under test for `npm run eval:answers`: it is given the memory
# tools and the harness's labeled questions, and a judge grades its answers.
# Any OpenAI-compatible chat endpoint with tool calls. Keep it apart from the
# curator's so the two do not queue behind each other.
# ZEROMEM_EVAL_LLM_URL=http://framework.lan:13306/v1
# ZEROMEM_EVAL_LLM_MODEL=Qwen3.6-35B-A3B
# ZEROMEM_EVAL_LLM_API_KEY=
# ZEROMEM_EVAL_LLM_TIMEOUT_MS=600000
# Cap on one reply, reasoning included, so a model thinking in circles is cut off.
# ZEROMEM_EVAL_LLM_MAX_TOKENS=4096
# The grader, when it should not be the model under test (same four suffixes).
# ZEROMEM_EVAL_JUDGE_LLM_URL=
# ZEROMEM_EVAL_JUDGE_LLM_MODEL=
